# Copy this file to .env.local and fill in your values
# .env.local is gitignored and should NEVER be committed

# Sanity CMS — get these from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-12

# HubSpot Contact Form (used by the /api/contact route)
# Get these from app.hubspot.com → Marketing → Forms → your form → Embed
HUBSPOT_PORTAL_ID=your_portal_id_here
HUBSPOT_FORM_GUID=your_form_guid_here
